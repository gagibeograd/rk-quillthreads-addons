<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>plg_system_rkqtavatar</name>
	<creationDate>September 2026</creationDate>
	<author>Radnička Klasa</author>
	<authorUrl>https://radnickaklasa.com</authorUrl>
	<copyright>2026 Radnička Klasa</copyright>
	<license>GNU/GPL v2 or later</license>
	<version>1.0.0</version>
	<description>PLG_SYSTEM_RKQTAVATAR_XML_DESCRIPTION</description>

	<files>
		<filename plugin="rkqtavatar">rkqtavatar.php</filename>
		<folder>sql</folder>
		<folder>language</folder>
	</files>

	<media destination="plg_system_rkqtavatar" folder="media">
		<folder>js</folder>
		<folder>css</folder>
	</media>

	<languages folder="language">
		<language tag="en-GB">en-GB/plg_system_rkqtavatar.ini</language>
		<language tag="en-GB">en-GB/plg_system_rkqtavatar.sys.ini</language>
		<language tag="sr-YU">sr-YU/plg_system_rkqtavatar.ini</language>
		<language tag="sr-YU">sr-YU/plg_system_rkqtavatar.sys.ini</language>
	</languages>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>

	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="gallery_path" type="text" default="images/quillthreads/avatars" label="PLG_SYSTEM_RKQTAVATAR_FIELD_GALLERY_PATH_LABEL" description="PLG_SYSTEM_RKQTAVATAR_FIELD_GALLERY_PATH_DESC" />
				<field name="show_picker" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="PLG_SYSTEM_RKQTAVATAR_FIELD_SHOW_PICKER_LABEL" description="PLG_SYSTEM_RKQTAVATAR_FIELD_SHOW_PICKER_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="remember" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="PLG_SYSTEM_RKQTAVATAR_FIELD_REMEMBER_LABEL" description="PLG_SYSTEM_RKQTAVATAR_FIELD_REMEMBER_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
